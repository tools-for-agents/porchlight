{
  "name": "hangar",
  "version": "0.1.0",
  "private": false,
  "description": "Nine bays. Point each one at a folder and a Claude agent starts there, live, in the tile.",
  "license": "MIT",
  "author": "tools-for-agents",
  "main": "src/main.js",
  "scripts": {
    "start": "electron .",
    "rebuild": "electron-rebuild -f -w node-pty",
