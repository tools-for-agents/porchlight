{
  "name": "hangar",
  "version": "0.1.0",
  "private": false,
  "description": "Nine bays. Point each one at a folder and a Claude agent starts there, live, in the tile.",
  "license": "MIT",
  "author": "tools-for-agents",
  "main": "src/main.js",
  "scripts": {
    "start": "electron .",
    "rebuild": "electron-rebuild -f -w node-pty",
    "postinstall": "electron-rebuild -f -w node-pty",
    "dist": "electron-builder --mac --publish never"
  },
  "devDependencies": {
    "electron": "^33.2.0",
    "@electron/rebuild": "^3.7.1",
    "electron-builder": "^25.1.8"
  },
  "dependencies": {
    "node-pty": "^1.0.0",
    "@xterm/xterm": "^5.5.0",
    "@xterm/addon-fit": "^0.10.0"
  },
  "build": {
    "appId": "dev.toolsforagents.hangar",
    "productName": "hangar",
    "files": [
      "src/**/*",
      "docs/logo.svg",
      "!**/*.map"
    ],
    "mac": {
      "icon": "build/icon.icns",
      "category": "public.app-category.developer-tools",
      "target": [
        "dmg",
        "zip"
      ]
    },
    "directories": {
      "buildResources": "build"
    }
  }
}