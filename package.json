    "dist": "electron-builder --mac --publish never"
  },
  "devDependencies": {
    "electron": "^33.2.0",
    "@electron/rebuild": "^3.7.1",
    "electron-builder": "^25.1.8"
  },
  "dependencies": {
    "node-pty": "^1.0.0",
    "@xterm/xterm": "^5.5.0",
    "@xterm/addon-fit": "^0.10.0"
  }
